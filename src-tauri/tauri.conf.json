{
  "productName": "童年游戏合集",
  "version": "1.0.0",
  "identifier": "io.github.jiangxincode.childhood",
  "build": {
    "beforeDevCommand": "npm run build:dist",
    "beforeBuildCommand": "npm run build:dist",
    "frontendDist": "../dist",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "童年游戏合集",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https://hm.baidu.com https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://hm.baidu.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://hm.baidu.com; connect-src 'self' https://hm.baidu.com https://cdn.jsdelivr.net; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "经典童年棋牌游戏合集",
    "longDescription": "免费玩刀杀鸡、龙虎斗、五子棋、中国象棋、围棋、跳棋等23款经典童年棋牌游戏，离线即玩。",
    "copyright": "Copyright © 2026 JiangXin",
    "publisher": "JiangXin",
    "homepage": "https://jiangxincode.github.io/childhood/",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      },
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
